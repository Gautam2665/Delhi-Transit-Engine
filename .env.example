# Delhi Transit Engine — Environment Configuration
# Add your Delhi Transport Stack API key to enable live streaming GTFS-RT polling.
# If left blank, the engine automatically seeds from the bundled local VehiclePositions.pb archive.
GTFS_RT_API_KEY=your_api_key_here
GTFS_RT_URL=https://delhi.transportstack.in/api/dataset/otd/get-file?agency=delhi-buses&category=realtime_gtfs&filename=VehiclePositions.pb
